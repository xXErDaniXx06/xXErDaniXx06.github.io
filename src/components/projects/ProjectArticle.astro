---
import { getDictionary, type Lang } from '../../i18n';
import type { LocalizedProject } from '../../portfolio';
import Icon from '../ui/Icon.astro';
import StatusBadge from '../ui/StatusBadge.astro';
import PeriodTime from './PeriodTime.astro';
import ProjectMedia from './ProjectMedia.astro';

interface Props {
  project: LocalizedProject;
  lang: Lang;
  eager?: boolean;
}

const { project, lang, eager = false } = Astro.props;
const t = getDictionary(lang).projects;
const titleId = `project-${project.id}-title`;
---

<article
  id={`project-${project.id}`}
  aria-labelledby={titleId}
  class="grid gap-8 py-12 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-12 lg:py-16"
>
  <div>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <StatusBadge status={project.status} label={project.statusLabel} />
      <PeriodTime period={project.period} class="font-mono text-xs text-subtle" />
    </div>
    <h2 id={titleId} class="mt-4 text-2xl font-semibold tracking-tight text-fg">
      {project.title}
    </h2>
    <p class="mt-1 text-sm text-muted">{project.organization}</p>
    <p class="rich-text mt-5 leading-relaxed text-muted" set:html={project.description} />

    <h3 class="mt-7 text-xs font-semibold tracking-wide text-subtle uppercase">{t.milestones}</h3>
    <ul class="mt-3 space-y-2">
      {project.milestones.map((milestone) => (
        <li class="flex gap-3 text-sm leading-relaxed text-fg">
          <Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent" />
          <span>{milestone}</span>
        </li>
      ))}
    </ul>

    <ul class="mt-6 flex flex-wrap gap-2" aria-label={t.tags}>
      {project.tags.map((tag) => (
        <li class="rounded-md border border-line bg-surface px-2.5 py-1 text-xs font-medium text-muted">{tag}</li>
      ))}
    </ul>
  </div>
  <!-- En móvil la imagen va después del texto; en escritorio, a la izquierda. -->
  <div class="md:order-first">
    <ProjectMedia project={project} lang={lang} eager={eager} />
  </div>
</article>
