---
// Campo del formulario de contacto con su etiqueta. Los atributos tool* son de WebMCP
// (API declarativa): describen el campo a los agentes que rellenan el formulario.
import type { MessageField } from '../../lib/contact';
import { MESSAGE_LIMITS } from '../../lib/contact';

interface Props {
  name: MessageField;
  label: string;
  placeholder: string;
  description: string;
  type?: 'text' | 'email';
  autocomplete?: string;
  multiline?: boolean;
}

const { name, label, placeholder, description, type = 'text', autocomplete, multiline = false } = Astro.props;
const id = `contact-${name}`;
const control =
  'mt-2 block w-full rounded-md border border-line-strong/70 bg-bg px-3.5 py-2.5 text-sm text-fg placeholder:text-subtle transition-colors hover:border-line-strong focus:border-accent focus:outline-2 focus:outline-offset-0 focus:outline-accent aria-[invalid=true]:border-danger';
---

<div>
  <label for={id} class="block text-sm font-medium text-fg">
    {label}
    <span class="text-danger" aria-hidden="true">
      *
    </span>
  </label>
  {multiline ? (
    <textarea
      id={id}
      name={name}
      rows="6"
      required
      maxlength={MESSAGE_LIMITS[name]}
      placeholder={placeholder}
      toolparamdescription={description}
      class={`${control} resize-y`}
    />
  ) : (
    <input
      id={id}
      name={name}
      type={type}
      required
      maxlength={MESSAGE_LIMITS[name]}
      autocomplete={autocomplete}
      placeholder={placeholder}
      toolparamdescription={description}
      class={control}
    />
  )}
</div>
