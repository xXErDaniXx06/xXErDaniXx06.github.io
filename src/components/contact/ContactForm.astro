---
// Formulario de contacto. Lo envía src/scripts/contact-form.ts a POST /api/v1/contact,
// con una comprobación de Cloudflare Turnstile que solo se carga al empezar a escribir.
// También es una herramienta WebMCP declarativa (send_contact_message): un agente puede
// rellenarlo y la persona confirma el envío pulsando el botón.
import { API_PATHS } from '../../agent/api-resources';
import { TURNSTILE_SITE_KEY } from '../../config/turnstile';
import { getDictionary, type Lang } from '../../i18n';
import Icon from '../ui/Icon.astro';
import FormField from './FormField.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang).contact.form;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || TURNSTILE_SITE_KEY;
const messages = { submit: t.submit, sending: t.sending, success: t.success, errors: t.errors };
---

<section
  aria-labelledby="contact-form-title"
  class="rounded-lg border border-line bg-raised p-6 shadow-[var(--shadow)] sm:p-8"
>
  <h2 id="contact-form-title" class="text-xl font-semibold tracking-tight text-fg">
    {t.title}
  </h2>
  <p class="mt-1 text-sm text-subtle">{t.required}</p>

  <form
    method="post"
    action={API_PATHS.contact}
    novalidate
    class="mt-6 space-y-5"
    data-contact-form
    data-lang={lang}
    data-sitekey={siteKey}
    data-messages={JSON.stringify(messages)}
    toolname="send_contact_message"
    tooldescription="Send an email message to Daniel Carrasco García through his portfolio contact form. All fields are required. The person browsing confirms the message by pressing the send button."
  >
    <div class="grid gap-5 sm:grid-cols-2">
      <FormField
        name="name"
        label={t.name}
        placeholder={t.placeholderName}
        autocomplete="name"
        description="Full name of the person sending the message (max. 100 characters)."
      />
      <FormField
        name="email"
        type="email"
        label={t.email}
        placeholder={t.placeholderEmail}
        autocomplete="email"
        description="Email address where Daniel can reply (max. 100 characters)."
      />
    </div>
    <FormField
      name="subject"
      label={t.subject}
      placeholder={t.placeholderSubject}
      description="Subject of the message (max. 100 characters)."
    />
    <FormField
      name="message"
      label={t.message}
      placeholder={t.placeholderMessage}
      description="Body of the message (max. 3000 characters)."
      multiline
    />

    <div data-turnstile></div>

    <p data-form-status role="status" class="hidden rounded-md px-4 py-3 text-sm font-medium"></p>

    <button
      type="submit"
      class="inline-flex w-full items-center justify-center gap-2 rounded-md bg-accent px-5 py-3 text-sm font-semibold text-accent-fg transition-colors hover:bg-accent-hover disabled:cursor-wait disabled:opacity-70 sm:w-auto"
    >
      <span data-submit-label>{t.submit}</span>
      <Icon name="arrow-right" class="size-4" />
    </button>

    <p class="rich-text text-xs leading-relaxed text-subtle" set:html={t.notice} />
  </form>
</section>
