---
import { getDictionary, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const t = getDictionary(Astro.props.lang);
---

<a
  href="#main"
  class="sr-only z-50 rounded-md bg-accent px-4 py-2 text-sm font-semibold text-accent-fg focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
>
  {t.common.skipToContent}
</a>
