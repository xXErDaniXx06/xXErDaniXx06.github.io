---
import { PAGE_IDS, pageHref, type PageId } from '../../data/pages';
import { CONTACT, PERSON_NAME } from '../../data/profile';
import { getDictionary, type Lang } from '../../i18n';
import Icon from '../ui/Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import PreferencesMenu from './PreferencesMenu.astro';

interface Props {
  lang: Lang;
  page?: PageId | undefined;
}

const { lang, page } = Astro.props;
const t = getDictionary(lang);
const links = PAGE_IDS.map((id) => ({ id, href: pageHref(lang, id), label: t.nav.pages[id] }));
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/95 backdrop-blur-sm" data-print="hide">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-5 sm:px-8">
    <a
      href={pageHref(lang, 'index')}
      class="mr-auto text-[0.95rem] font-semibold tracking-tight text-fg hover:text-accent"
      aria-label={`${t.nav.pages.index} – ${PERSON_NAME}`}
    >
      {PERSON_NAME}
    </a>

    <nav aria-label={t.nav.mainLabel} class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.id === page ? 'page' : undefined}
              class:list={[
                'relative inline-flex h-16 items-center px-3 text-sm font-medium transition-colors',
                link.id === page
                  ? 'text-fg after:absolute after:inset-x-3 after:bottom-0 after:h-0.5 after:bg-accent'
                  : 'text-muted hover:text-fg',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-1 sm:gap-2">
      <LanguageSwitcher lang={lang} page={page} class="hidden sm:flex" />
      <PreferencesMenu lang={lang} />
      <a
        href={CONTACT.cvPath}
        download
        class="hidden items-center gap-1.5 rounded-md border border-line px-3 py-1.5 text-sm font-medium text-fg transition-colors hover:border-line-strong sm:inline-flex"
        aria-label={t.nav.downloadCv}
      >
        <Icon name="download" class="size-4" />
        {t.nav.cv}
      </a>
      <button
        type="button"
        popovertarget="mobile-menu"
        class="inline-flex size-10 items-center justify-center rounded-md text-muted transition-colors hover:bg-surface hover:text-fg lg:hidden"
        aria-label={t.nav.openMenu}
      >
        <Icon name="menu" class="size-5" />
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    popover
    aria-label={t.nav.mobileLabel}
    class="fixed inset-x-0 top-16 bottom-auto m-0 w-full border-b border-line bg-bg px-5 pt-3 pb-6 text-fg shadow-[0_12px_32px_rgb(15_23_42/0.12)] sm:px-8"
  >
    <div class="mx-auto max-w-6xl">
      <div class="mb-2 flex justify-end">
        <button
          type="button"
          popovertarget="mobile-menu"
          popovertargetaction="hide"
          class="inline-flex size-10 items-center justify-center rounded-md text-muted hover:bg-surface hover:text-fg"
          aria-label={t.nav.closeMenu}
        >
          <Icon name="close" class="size-5" />
        </button>
      </div>
      <ul class="divide-y divide-line border-y border-line">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.id === page ? 'page' : undefined}
              class:list={[
                'flex items-center justify-between py-3 text-base font-medium',
                link.id === page ? 'text-accent' : 'text-fg hover:text-accent',
              ]}
            >
              {link.label}
              <Icon name="arrow-right" class="size-4 text-subtle" />
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-5 flex items-center justify-between gap-4">
        <LanguageSwitcher lang={lang} page={page} />
        <a
          href={CONTACT.cvPath}
          download
          class="inline-flex items-center gap-1.5 rounded-md bg-accent px-4 py-2 text-sm font-semibold text-accent-fg hover:bg-accent-hover"
          aria-label={t.nav.downloadCv}
        >
          <Icon name="download" class="size-4" />
          {t.nav.cv}
        </a>
      </div>
    </div>
  </nav>
</header>
