---
import { ICONS, type IconDefinition, type IconName } from './icons';

interface Props {
  name: IconName;
  class?: string;
  /** Texto para lectores de pantalla. Sin él, el icono es decorativo. */
  label?: string;
}

const { name, class: className = 'size-5', label } = Astro.props;
const icon: IconDefinition = ICONS[name];
const stroked = !icon.filled;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class={className}
  fill={stroked ? 'none' : 'currentColor'}
  stroke={stroked ? 'currentColor' : 'none'}
  stroke-width={stroked ? '1.75' : undefined}
  stroke-linecap={stroked ? 'round' : undefined}
  stroke-linejoin={stroked ? 'round' : undefined}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={icon.body}
/>
