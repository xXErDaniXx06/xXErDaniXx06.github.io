{
  "name": "danielcarrascogarcia-portfolio",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "description": "Porfolio de Daniel Carrasco García (Astro + Cloudflare Workers), preparado para personas y agentes de IA.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run worker:dev",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "typecheck": "astro check && tsc -p worker",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run check && npm run build && npm run validate:html && wrangler deploy",
    "worker:dev": "SITE_URL=http://localhost:8787 PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA astro build && wrangler dev --local-upstream localhost:8787",
    "worker:types": "wrangler types worker/worker-configuration.d.ts",
    "lighthouse": "node scripts/lighthouse.mjs",
    "score": "node scripts/agent-score.mjs",
    "wba:key": "node scripts/web-bot-auth-key.mjs",
    "brand-assets": "node scripts/brand-assets.mjs",
    "fonts": "node scripts/subset-font.mjs",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "validate:html": "html-validate \"dist/**/*.html\""
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "astro": "^7.4.1",
    "chrome-launcher": "^1.2.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.13.0",
    "html-validate": "^11.17.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer-core": "^25.15.0",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
